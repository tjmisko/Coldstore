FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY coldstore /usr/local/bin/coldstore
COPY tests/fixtures /app/fixtures

# The container is started with `--config /app/coldstore.toml`; without this COPY the
# daemon exits 1 on "failed to load config" before it ever binds a port.
COPY docker/coldstore.test.toml /app/coldstore.toml

# cold_storage_path and the managed folder path from coldstore.test.toml. Compose
# mounts volumes over both, but create them so the image also runs standalone.
RUN mkdir -p /data/cold /data/sync

# The marker has to be created at START, not at build time: compose mounts the
# shared-sync volume over /data/sync, which hides anything the image put there.
# Without it FolderReady treats the folder as unmounted -- correctly, since that is
# exactly what an empty mount looks like -- and the daemon moves nothing all run.
# The real Syncthing service creates .stfolder for folders it manages; this stack
# gives coldstore a directory Syncthing has not been told about.
ENTRYPOINT ["/bin/sh", "-c", "mkdir -p /data/sync/.stfolder && exec coldstore \"$@\"", "--"]
CMD ["--config", "/app/coldstore.toml"]
