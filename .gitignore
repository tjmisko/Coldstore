.env

# Go binaries
/coldstore
/seed-demo

# SQLite
*.db
*.db-shm
*.db-wal

# Frontend build artifacts.
# The directory itself is NOT ignored: internal/api/dist/.gitkeep is tracked so that
# //go:embed all:dist in internal/api/static.go resolves on a clean checkout, before
# anyone has run `make frontend`. Everything else in here is generated by Vite.
internal/api/dist/*
!internal/api/dist/.gitkeep

# Demo config
coldstore-demo.toml

# Worktrees live here (gh worktree create)
.worktrees/

# Deployment survey for this specific installation: LAN addresses, Syncthing
# device and folder IDs, backup locations. This repo is public -- keep it local.
docs/first-deploy.md

# Step-by-step checklist for this specific installation: LAN address, Syncthing
# folder IDs, real paths and budgets. Same reason as first-deploy.md.
docs/deploy-checklist.md

# Host-specific runbook for reconciling production Syncthing folders with
# Coldstore. It records real folder IDs and paths once the blanks are filled.
docs/syncthing-coldstore-migration.md

# Live deployment inputs and generated drop-in bundles contain personal
# principals, device IDs and host paths. The repository is public.
/coldstore.toml.live
/deploy/microserver-live/

# Local secret material must never be tracked or make release builds appear
# dirty. Service credentials belong outside the repository in production.
/.secrets

# Verified repository, test, blocker and production state for this specific
# installation. It records production facts that do not belong in a public repo.
/STATUS.md
